node_modules
dist
.DS_Store
*.local

# Training scratch: the venv, the teacher's cached output, and checkpoints are all
# reproducible from train/ and far too large to track.
train/.venv
train/data
train/runs
train/*.pt
__pycache__
*.pyc

# Trained models ARE tracked. They are what makes a deployed build usable without asking
# everyone who opens it to train their own, and export.py lists each one in
# public/models/index.json so the app can offer it. A model is a couple of megabytes;
# if a directory of experiments starts accumulating here, prune it rather than ignoring it.

# TypeScript incremental build state, regenerated on every build.
*.tsbuildinfo
